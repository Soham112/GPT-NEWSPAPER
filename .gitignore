### Project-wide ignores
# Python virtual environments
venv/
.venv/
env/

# Python cache/artifacts
__pycache__/
*.py[cod]
*$py.class
*.so

# Node / Next.js artifacts
node_modules/
.next/
out/
dist/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs / caches
outputs/
cache/
coverage/

# Environment variables
.env
.env.local
.env*.local

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

### Frontend-specific overrides
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build
frontend/.pnp
frontend/.pnp.js
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.vercel
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/coverage/
frontend/.DS_Store
frontend/*.pem