# .gitignore

# Virtual environments
venv/
.venv/
env/
.env

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Output files
outputs/

# Cache
cache/

# Environment variables
.env
.env.local
.env*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Frontend / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build
frontend/.pnp
frontend/.pnp.js
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.vercel
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/coverage/
frontend/.DS_Store
frontend/*.pem